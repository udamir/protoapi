{
  "name": "protoapi",
  "version": "0.1.0",
  "description": "ProtoApi: a JSON document format for Protocol Buffers APIs, with builders from .proto text and FileDescriptorSet, a printer and a source map",
  "keywords": [
    "api",
    "descriptor",
    "diff",
    "grpc",
    "proto",
    "protoapi",
    "protobuf",
    "schema"
  ],
  "homepage": "https://udamir.github.io/protoapi/",
  "license": "MIT",
  "author": "Damir Yusipov",
  "repository": {
    "type": "git",
    "url": "https://github.com/udamir/protoapi"
  },
  "files": [
    "dist",
    "browser",
    "schemas",
    "bundle/LICENSES",
    "bundle/VERSIONS.md",
    "src/parser/NOTICE",
    "src/parser/LICENSE-MIT",
    "src/parser/LICENSE-APACHE",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.cts"
      ]
    }
  },
  "unpkg": "./browser/protoapi.min.js",
  "jsdelivr": "./browser/protoapi.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"for (const d of ['dist', 'browser']) require('node:fs').rmSync(d, { recursive: true, force: true })\" && vp pack",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test:dist": "node test/smoke/smoke.cjs && node test/smoke/smoke.mjs",
    "bundle:fetch": "tsx scripts/fetch-bundle.ts",
    "bundle:gen": "tsx scripts/gen-bundle.ts",
    "images": "tsx scripts/images.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:dist"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.7.0",
    "vitepress": "2.0.0-alpha.21",
    "vue": "^3.5.46"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.8.0"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0"
}
